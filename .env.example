# Copy to .env for local runs. Never commit .env.
DISCORD_TOKEN=
# Main model (gpt-6-luna by default). Not needed if MODEL is a grok-* model.
OPENAI_API_KEY=
# Optional: enables X search via Grok (search_x) and the Deep mode.
XAI_API_KEY=
# Free tier at https://app.tavily.com (1,000 searches/month). Without it there is no web search outside Deep mode.
TAVILY_API_KEY=

MODEL=gpt-6-luna
GROK_MODEL=grok-4.3
# Optional for OpenAI reasoning models: low | medium | high
REASONING_EFFORT=
# auto (web + X via Grok when relevant), web, x, deep, none
DEFAULT_SEARCH=auto
X_SEARCHES_PER_ANSWER=1
DAILY_BUDGET_USD=2.00
PER_USER_DAILY_USD=0.50
USER_COOLDOWN_S=5
MAX_OUTPUT_TOKENS=4000
SEARCH_RESULTS=5
# Discord context sent with a mention (0 turns each off)
CONTEXT_MESSAGES=12
REPLY_DEPTH=5
MAX_IMAGES=4
SHOW_DETAILS=false
# Optional: your server ID, so /ask shows up instantly while testing
DEV_GUILD_IDS=
