# Copy to .env for local runs. Never commit .env.
DISCORD_TOKEN=
XAI_API_KEY=
# Free tier at https://app.tavily.com (1,000 searches/month). Without it, "web" falls back to xAI's search.
TAVILY_API_KEY=

GROK_MODEL=grok-4.3
# web (Tavily, cheap), deep (xAI web+X), x, none
DEFAULT_SEARCH=web
DAILY_BUDGET_USD=2.00
PER_USER_DAILY_USD=0.50
USER_COOLDOWN_S=5
MAX_OUTPUT_TOKENS=1500
SEARCH_RESULTS=5
SHOW_COST=true
# Optional: your server ID, so /ask shows up instantly while testing
DEV_GUILD_IDS=
